# Public (safe to expose to the browser — used for reading companies/timeslot availability)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (NEVER prefix with VITE_ — must not reach the browser bundle)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard password (visit /admin). Defaults to "lodestart.ai" if unset.
ADMIN_PASSWORD=lodestart.ai
