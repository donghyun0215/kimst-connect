# --- Notion CMS for K-Startups Events (optional) ---
# When unset, the events page shows the built-in fallback list.
NOTION_TOKEN=secret_xxx
NOTION_EVENTS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase CMS + admin panel ---
